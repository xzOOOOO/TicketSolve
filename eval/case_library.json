  {
    "case_id": "srebench:DB_SLOW_QUERY",
    "title": "Orders pending slow query",
    "symptoms": [
      "订单查询很慢",
      "pending orders endpoint slow",
      "DB_SLOW_QUERY"
    ],
    "tool_evidence": [
      "check_db_slow_query: idx_orders_status_created_at is missing",
      "pending-orders endpoint is slow"
    ],
    "root_cause": "orders(status, created_at desc) 索引缺失，导致 pending orders 查询变慢。",
    "possible_causes": [
      "missing index idx_orders_status_created_at",
      "slow database query"
    ],
    "successful_repair_action": {
      "action_type": "REBUILD_ORDERS_INDEX",
      "target": "DB_SLOW_QUERY",
      "command": "docker exec srebench-postgres psql -U labuser -d labdb -c \"create index if not exists idx_orders_status_created_at on orders (status, created_at desc);\""
    },
    "verification": {
      "commands": [
        "curl http://localhost:18080/orders/pending",
        "curl http://localhost:18080/health"
      ],
      "expected_result": "orders pending endpoint returns quickly with HTTP 2xx"
    },
    "created_at": "2026-06-04T00:00:00+00:00",
    "updated_at": "2026-06-04T00:00:00+00:00"
  },
